## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files (local debug settings, window layouts, etc.)
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
arm/
arm64/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio 2015+ cache/options directory
.vs/

# MSTest test Results
TestResults/
*.testresults

# NUnit
*.nunit
*.VisualState.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# ReSharper (if you use it)
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode (another VS extension)
.JustCode

# Team Foundation Version Control
$tf/

# DotCover
*.dotCover

# Click-Once publish folder
publish/

# Azure build output
csx/
*.builds

# Windows Azure Pack
wap/

# TypeScript output
*.js
*.js.map
*.js.metadata
*.tsbuildinfo

# End of https://github.com/github/gitignore/blob/main/VisualStudio.gitignore